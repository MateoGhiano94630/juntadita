# Connection string de Neon. Se saca de la consola de Neon → Connection Details.
# Tiene que terminar en ?sslmode=require
DATABASE_URL="postgresql://usuario:password@ep-algo-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# URL pública de la app. La usa el Open Graph para armar URLs absolutas.
# Local: http://localhost:3000
# Túnel: la URL https que te da ngrok
# Vercel: se completa sola, no hace falta definirla
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
